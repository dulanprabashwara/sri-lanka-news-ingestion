INGESTION_HTTP_TIMEOUT_SECONDS=15
INGESTION_HTTP_MAX_REDIRECTS=5
INGESTION_HTTP_USER_AGENT=SriLankaNewsIngestion/0.1 (+https://github.com/dulanprabashwara/sri-lanka-news-ingestion)
INGESTION_LOG_LEVEL=INFO
INGESTION_BACKEND_BASE_URL=http://localhost:8080
INGESTION_API_KEY=<same-strong-random-secret-as-backend>
INGESTION_DAILY_MIRROR_FEED_URL=https://www.dailymirror.lk/rss/breaking_news/108
INGESTION_NEWSFIRST_LISTING_URL=https://www.newsfirst.lk/latest
INGESTION_HIRU_NEWS_SINHALA_LISTING_URL=https://www.hirunews.lk/
INGESTION_ADA_DERANA_SINHALA_FEED_URL=https://sinhala.adaderana.lk/rss.php
INGESTION_ADA_DERANA_SINHALA_HOMEPAGE_URL=https://sinhala.adaderana.lk/
INGESTION_RUN_LIMIT=3
